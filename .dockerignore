# ==============================================================================
# Docker 빌드 시 컨텍스트에서 제외할 파일 및 디렉토리 (.dockerignore)
# ==============================================================================

# 로컬의 대용량 의존성 폴더 (컨테이너 내부에서 새로 설치하므로 전송 불필요)
node_modules

# Expo 개발/빌드 시 생성되는 임시 캐시 폴더
.expo
.expo-shared

# 웹/앱 프로덕션 번들링 산출물
web-build
dist

# Git 버전 관리 메타데이터
.git

# 환경변수 파일 (보안을 위해 이미지 빌드에서 제외)
.env
.env.*

# 패키지 매니저 로그 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
